{
  "name": "@local/dsh-paper-miner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read PDF research papers at a fraction of their token cost and mine them for extension work.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "skills",
    "cordis.patch.yml",
    "docs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  }
}
